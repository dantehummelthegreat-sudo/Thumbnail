# Server-side only — enables the optional "Get AI critique" button.
# Used by the dev server middleware (npm run dev) and by the /api/critique
# serverless function when deployed (e.g. set it in Vercel project settings).
# The app works fully without it; the critique button will just say it's not
# set up. Never expose this in client code (no VITE_ prefix).
ANTHROPIC_API_KEY=
